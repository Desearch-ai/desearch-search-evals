# Copy to .env and fill in. Loaded by both run.sh and the Python script.
# Simple KEY=value lines only (no spaces around =, quotes optional).

# --- Required ---
# Used for question generation AND embedding-based dedup.
OPENAI_API_KEY=

# --- HuggingFace push (optional; leave HF_DATASET_REPO blank to stay local-only) ---
# Set BOTH to push questions/<date>.jsonl to your dataset each run. Private gold
# answers are NEVER uploaded. A write-scoped token for the repo below.
HF_TOKEN=
HF_DATASET_REPO=

# --- Optional tuning ---
# OpenAI model used to invert articles and screen questions.
# GEN_MODEL=gpt-4.1-nano
# Outbound HTTP(S) proxy for article fetches, e.g. http://user:pass@host:port
# Helps when outlets rate-limit a single server IP.
# FETCH_PROXY=

# --- Daily-run knobs read by run.sh (sensible defaults if unset) ---
# PYTHON=python3
# ARTICLES=5000
# TARGET=1100
# LOOKBACK=2
