# Copy to .env and fill in. Loaded by both run.sh and the Python script.
# Simple KEY=value lines only (no spaces around =, quotes optional).

# --- Required ---
# LLM provider for generating + screening questions:
#   chutes  -> Chutes Qwen3 (set CHUTES_API_TOKEN below). Default for daily runs.
#   openai  -> OpenAI / OpenAI-compatible (set OPENAI_API_KEY, optional OPENAI_BASE_URL).
LLM_PROVIDER=chutes
CHUTES_API_TOKEN=

# OpenAI key (used when LLM_PROVIDER=openai, and for embedding-based dedup).
OPENAI_API_KEY=

# Required ONLY for the X lane (generate_x_questions.py). Desearch API key for
# GET https://api.desearch.ai/twitter. Sent verbatim as the Authorization header.
DESEARCH_API_KEY=
# DESEARCH_BASE_URL=https://api.desearch.ai

# --- HuggingFace push (optional; leave HF_DATASET_REPO blank to stay local-only) ---
# Set BOTH to push questions/<date>.jsonl to your dataset each run. Private gold
# answers are NEVER uploaded. A write-scoped token for the repo below.
HF_TOKEN=
HF_DATASET_REPO=

# --- Optional tuning ---
# OpenAI model used to invert articles and screen questions.
# GEN_MODEL=gpt-4.1-nano
# Outbound HTTP(S) proxy for article fetches, e.g. http://user:pass@host:port
# Helps when outlets rate-limit a single server IP.
# FETCH_PROXY=

# --- Daily-run knobs read by run.sh (sensible defaults if unset) ---
# PYTHON=python3
# ARTICLES=5000
# TARGET=1100
# LOOKBACK=2
